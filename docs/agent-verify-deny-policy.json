{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyUserDataReads",
      "Effect": "Deny",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:PartiQLSelect",
        "cognito-idp:ListUsers",
        "cognito-idp:ListUsersInGroup",
        "cognito-idp:AdminGetUser",
        "cognito-idp:AdminListGroupsForUser",
        "cognito-idp:AdminListUserAuthEvents",
        "cognito-idp:AdminGetDevice",
        "cognito-idp:AdminListDevices",
        "logs:Unmask"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyImageBucketListing",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::dev-sakekasu-images",
        "arn:aws:s3:::staging-sakekasu-images",
        "arn:aws:s3:::prod-sakekasu-images"
      ]
    },
    {
      "Sid": "DenySecretReads",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyDirectoryAndContactReads",
      "Effect": "Deny",
      "Action": [
        "identitystore:*User*",
        "identitystore:*GroupMembership*",
        "identitystore:IsMemberInGroups",
        "sso-directory:*",
        "account:GetContactInformation",
        "account:GetAlternateContact",
        "account:GetPrimaryEmail"
      ],
      "Resource": "*"
    }
  ]
}
