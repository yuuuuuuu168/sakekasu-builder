{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "sommelier",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "sommelier"
  },
  "runtimes": [
    {
      "name": "sommelier",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/sommelier/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_yw1VDKtxW/.well-known/openid-configuration",
          "allowedClients": ["iuv75jactiu7ffumrj71khmen"]
        }
      },
      "requestHeaderAllowlist": ["Authorization"],
      "envVars": [
        { "name": "PURCHASE_TABLE_NAME", "value": "dev-sakekasu-purchase-records" },
        { "name": "DRINKING_TABLE_NAME", "value": "dev-sakekasu-drinking-records" },
        { "name": "COGNITO_USER_POOL_ID", "value": "ap-northeast-1_yw1VDKtxW" },
        { "name": "COGNITO_APP_CLIENT_ID", "value": "iuv75jactiu7ffumrj71khmen" },
        { "name": "TAVILY_API_KEY_SECRET_ID", "value": "dev-sakekasu/sommelier/tavily-api-key" },
        { "name": "LLM_PROVIDER", "value": "anthropic" },
        { "name": "ANTHROPIC_MODEL_CHAT", "value": "claude-haiku-5-5" },
        { "name": "BEDROCK_MODEL_ID", "value": "jp.anthropic.claude-haiku-4-5-20251001-v1:0" },
        { "name": "ANTHROPIC_FEDERATION_RULE_ID", "value": "fdrl_01Tqxpf4VMtFM2fiCuGndsw3" },
        { "name": "ANTHROPIC_ORGANIZATION_ID", "value": "c155ee76-4f2a-4282-aae0-a453dd5145af" },
        { "name": "ANTHROPIC_SERVICE_ACCOUNT_ID", "value": "svac_01AZtWEtET1fTHKpwvVcMkQS" },
        { "name": "ANTHROPIC_WORKSPACE_ID", "value": "wrkspc_01RTpiayq3B1SM6Ap151XkLY" }
      ]
    }
  ],
  "memories": [
    {
      "name": "preference",
      "eventExpiryDuration": 90,
