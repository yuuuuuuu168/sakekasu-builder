{
  "$schema": "https://schema.agentcore.aws.dev/v1/agentcore.json",
  "name": "sommelier",
  "version": 1,
  "managedBy": "CDK",
  "tags": {
    "agentcore:created-by": "agentcore-cli",
    "agentcore:project-name": "sommelier"
  },
  "runtimes": [
    {
      "name": "sommelier",
      "build": "CodeZip",
      "entrypoint": "main.py",
      "codeLocation": "app/sommelier/",
      "runtimeVersion": "PYTHON_3_14",
      "networkMode": "PUBLIC",
      "protocol": "HTTP",
      "authorizerType": "CUSTOM_JWT",
      "authorizerConfiguration": {
        "customJwtAuthorizer": {
          "discoveryUrl": "https://cognito-idp.ap-northeast-1.amazonaws.com/ap-northeast-1_eZOfInCT4/.well-known/openid-configuration",
          "allowedClients": ["3a4unc2dbutrkm2hjn887s1h9m", "23dvtnv4hg8lj74e0fq7r7c0nv"]
        }
      },
      "requestHeaderAllowlist": ["Authorization"],
      "envVars": [
        { "name": "PURCHASE_TABLE_NAME", "value": "dev-sakekasu-purchase-records" },
        { "name": "DRINKING_TABLE_NAME", "value": "dev-sakekasu-drinking-records" },
        { "name": "COGNITO_USER_POOL_ID", "value": "ap-northeast-1_eZOfInCT4" },
        { "name": "COGNITO_APP_CLIENT_ID", "value": "3a4unc2dbutrkm2hjn887s1h9m,23dvtnv4hg8lj74e0fq7r7c0nv" }
      ]
    }
  ],
  "memories": [
    {
      "name": "preference",
      "eventExpiryDuration": 90,
      "strategies": [
        {
          "type": "USER_PREFERENCE",
          "name": "sakePreference",
          "description": "お酒の好み（味わい・産地・飲み方・シーン）を会話から抽出する",
          "namespaces": ["sommelier/preference/{actorId}"]
        }
      ]
    }
  ],
  "credentials": [],
  "evaluators": [],
  "onlineEvalConfigs": [],
  "agentCoreGateways": [],
  "policyEngines": []
}