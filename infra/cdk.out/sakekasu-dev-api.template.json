  "SakekasuApiSchemaCBE52513": {
   "Type": "AWS::AppSync::GraphQLSchema",
   "Properties": {
    "ApiId": {
     "Fn::GetAtt": [
      "SakekasuApiED3BBF54",
      "ApiId"
     ]
    },
    "Definition": "# SakeCategory 列挙型\nenum SakeCategory {\n  NIHONSHU\n  BEER\n  WINE\n  WHISKY\n  SHOCHU\n  OTHER\n}\n\n# 購入記録\ntype PurchaseRecord {\n  id: ID!\n  owner: String!\n  sakeName: String!\n  storeName: String!\n  price: Int!\n  purchaseDate: AWSDate!\n  category: SakeCategory!\n  memo: String\n  imageKey: String\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}\n\n# 飲酒記録\ntype DrinkingRecord {\n  id: ID!\n  owner: String!\n  sakeName: String!\n  placeName: String!\n  price: Int\n  drinkingDate: AWSDate!\n  category: SakeCategory!\n  drinkingMethod: String!\n  rating: Int!\n  memo: String\n  imageKey: String\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}\n\n# Presigned URL レスポンス\ntype PresignedUrlResponse {\n  uploadUrl: String!\n  key: String!\n}\n\n# クエリ\ntype Query {\n  getPurchaseRecord(id: ID!): PurchaseRecord\n  listPurchaseRecords: [PurchaseRecord!]!\n  getDrinkingRecord(id: ID!): DrinkingRecord\n  listDrinkingRecords: [DrinkingRecord!]!\n  getDownloadUrl(key: String!): String!\n}\n\n# ミューテーション\ntype Mutation {\n  createPurchaseRecord(input: CreatePurchaseRecordInput!): PurchaseRecord\n  updatePurchaseRecord(input: UpdatePurchaseRecordInput!): PurchaseRecord\n  deletePurchaseRecord(id: ID!): PurchaseRecord\n  createDrinkingRecord(input: CreateDrinkingRecordInput!): DrinkingRecord\n  updateDrinkingRecord(input: UpdateDrinkingRecordInput!): DrinkingRecord\n  deleteDrinkingRecord(id: ID!): DrinkingRecord\n  generateUploadUrl(\n    recordType: String!\n    recordId: String!\n    contentType: String!\n    fileName: String!\n  ): PresignedUrlResponse!\n}\n\n# 購入記録作成用 Input（id, owner, createdAt, updatedAt は自動生成）\ninput CreatePurchaseRecordInput {\n  sakeName: String!\n  storeName: String!\n  price: Int!\n  purchaseDate: AWSDate!\n  category: SakeCategory!\n  memo: String\n  imageKey: String\n}\n\n# 購入記録更新用 Input（id は必須、他はオプション）\ninput UpdatePurchaseRecordInput {\n  id: ID!\n  sakeName: String\n  storeName: String\n  price: Int\n  purchaseDate: AWSDate\n  category: SakeCategory\n  memo: String\n}\n\n# 飲酒記録作成用 Input（id, owner, createdAt, updatedAt は自動生成）\ninput CreateDrinkingRecordInput {\n  sakeName: String!\n  placeName: String!\n  price: Int\n  drinkingDate: AWSDate!\n  category: SakeCategory!\n  drinkingMethod: String!\n  rating: Int!\n  memo: String\n  imageKey: String\n}\n\n# 飲酒記録更新用 Input（id は必須、他はオプション）\ninput UpdateDrinkingRecordInput {\n  id: ID!\n  sakeName: String\n  placeName: String\n  price: Int\n  drinkingDate: AWSDate\n  category: SakeCategory\n  drinkingMethod: String\n  rating: Int\n  memo: String\n}\n"
   },
   "Metadata": {
    "aws:cdk:path": "sakekasu-dev-api/SakekasuApi/Schema"
   }
  },
